<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>ua.problab</groupId>
    <artifactId>probability-lab</artifactId>
    <version>1.0.0</version>
    <name>Лабораторія ймовірностей</name>
    <description>Веб-інструмент для уроків теорії ймовірностей: теорія, моделювання, практика, генерація завдань. Кваліфікаційна робота магістра, автор – Красавін Олег Олександрович (2 курс магістратури, група 51-фмт).</description>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>Національний університет «Чернігівський колегіум» імені Т. Г. Шевченка</name>
    </organization>

    <developers>
        <developer>
            <id>krasavin</id>
            <name>Красавін Олег Олександрович</name>
            <organization>НУЧК імені Т. Г. Шевченка, природничо-математичний факультет</organization>
            <roles>
                <role>автор</role>
                <role>розробник</role>
            </roles>
            <properties>
                <course>2 курс магістратури</course>
                <group>51-фмт</group>
                <specialty>А4.04 Середня освіта (Математика)</specialty>
            </properties>
        </developer>
    </developers>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>probability-lab</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
